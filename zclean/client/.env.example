# Client environment variables (Vite)
# Copy to `client/.env` and fill in when deploying. Vite only exposes
# variables prefixed with VITE_ and only reads them from this folder —
# the root .env is for the server and is NOT read by the frontend.

# Socket.io server URL for real-time chat/notifications.
# Leave unset in local development — the code falls back to
# http://localhost:5000 automatically.
# Example for deployment:
# VITE_SOCKET_URL=https://your-server-domain.com
VITE_SOCKET_URL=
