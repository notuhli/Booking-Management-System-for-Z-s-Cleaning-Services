# ════════════════════════════════════════════════════════════════════════════
# ZClean — server environment template
#
# Copy this file to `server/.env` and fill in the values. This template is the
# only one that belongs in git; `.env` itself never does.
#
# NOTE: the server reads `server/.env`. A copy at the project root is not used
# and should be deleted, so credentials do not live in two places and get
# rotated in only one.
# ════════════════════════════════════════════════════════════════════════════

PORT=5000

# 'development' or 'production'. Set it to production when deploying: it is the
# switch that keeps the password-reset code out of API responses.
NODE_ENV=development

# The exact address the site is served from. CORS and the websocket both allow
# this origin only, so a wrong value here stops the app from loading.
CLIENT_URL=http://localhost:5173

# Which proxies may be believed about the caller's IP address, which is what
# the rate limits count against. Leave this unset for local development: the
# Vite dev proxy runs on this machine and is trusted automatically.
# Set TRUST_PROXY=1 when deploying behind exactly one hosting proxy.
# Never set it to 'true' — anyone could then fake their address and get an
# unlimited allowance.
TRUST_PROXY=


# ── Database ────────────────────────────────────────────────────────────────
# Set DATABASE_URL to use Supabase (PostgreSQL). Leave it empty to fall back to
# the local MySQL/XAMPP settings below.
#
# Supabase → Project Settings → Database → Connection string → SESSION mode.
# Use the least-privilege role created by migration_v12, not the postgres
# superuser:  postgresql://zclean_app.<project-ref>:<password>@<host>:5432/postgres
DATABASE_URL=

# Local MySQL / XAMPP (only used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zclean_db
DB_USER=root
DB_PASS=


# ── Authentication ──────────────────────────────────────────────────────────
# Anyone who learns this value can mint a token with role "admin" and never
# needs a password, so it must be long and random — never a phrase.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d


# ── Email (Gmail app password, not the account password) ────────────────────
# Google Account → Security → 2-Step Verification → App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Email via Brevo HTTPS API (for deployment) ──────────────────────────────
# Set this when the host blocks outbound SMTP ports — Render's free tier does,
# which makes Gmail SMTP fail in deployment while working locally.
# Brevo free tier: 300 emails/day. brevo.com → SMTP & API → API Keys.
# Leave BREVO_API_KEY empty to keep using the Gmail SMTP settings above.
BREVO_API_KEY=
# The sender address shown to recipients. Must be verified in Brevo under
# Senders, Domains & Dedicated IPs → Senders. Falls back to SMTP_USER.
MAIL_FROM=
